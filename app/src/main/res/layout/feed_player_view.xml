<?xml version="1.0" encoding="utf-8"?>
<!-- The feed's video surface. A TextureView (not the default SurfaceView) so the video moves with the pager page
     frame by frame while the finger drags it, like TikTok's own feed. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/black" />
